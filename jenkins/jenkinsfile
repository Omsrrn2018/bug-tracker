pipeline {
    agent { label 'docker-node' }  // or 'any' if your only node has Docker

    stages {
        stage('Launch Application') {
            steps {
                sh 'docker version'
                sh 'which docker-compose || echo "docker-compose not in PATH"'
                sh 'docker-compose --version || echo "docker-compose missing"'
                sh 'docker-compose up --build -d'
            }
        }
    }

    post {
        always {
            // Use ONE of these:
            // cleanWs()      // if Workspace Cleanup plugin installed
            deleteDir()       // if you want to avoid extra plugins
        }
    }
}