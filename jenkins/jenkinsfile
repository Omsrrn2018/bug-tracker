pipeline {
    agent any

    environment {
        BACKEND_IMAGE = 'snakee/golang-junit:1.21'
        FRONTEND_IMAGE = 'node:20-alpine'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Backend Unit Tests') {
            steps {
                script {
                    docker.image(BACKEND_IMAGE).inside {
                        sh '''
                            go test -v ./... -coverprofile=coverage.out | tee result.log | go-junit-report > test-results.xml
                            go tool cover -html=coverage.out -o coverage.html
                        '''
                    }
                }
            }
            post {
                always {
                    junit 'test-results.xml'
                    publishHTML(target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: '.',
                        reportFiles: 'coverage.html',
                        reportName: 'Backend Code Coverage'
                    ])
                }
            }
        }

        stage('Frontend Unit Tests') {
            steps {
                script {
                    docker.image(FRONTEND_IMAGE).inside {
                        sh '''
                            npm install
                            npm test -- --coverage
                        '''
                    }
                }
            }
            post {
                always {
                    junit 'test-results.xml'
                    publishHTML(target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'coverage/lcov-report',
                        reportFiles: 'index.html',
                        reportName: 'Frontend Code Coverage'
                    ])
                }
            }
        }
    }

    post {
        always {
            cleanWs()
       