pipeline {
  agent any
  environment {
    DOCKER_HOST = 'unix:///var/run/docker.sock'
  }
  stages {
    stage('Checkout') {
      steps {
        checkout([$class: 'GitSCM', 
          branches: [[name: '*/main']], 
          userRemoteConfigs: [[url: 'https://github.com/Omsrrn2018/bug-tracker.git']]
        ])
        sh 'ls -la'
      }
    }
    stage('Unit Tests Backend') {
      agent {
        docker {
          image 'snakee/golang-junit:1.21'
          args '-w /var/jenkins_home/workspace/bugtrackker'
          reuseNode true
        }
      }
      steps {
        sh 'ls -la'
        sh 'go test ./...'
      }
    }
  }
}