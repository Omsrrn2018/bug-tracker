pipeline {
  agent any
  environment {
    DOCKER_HOST = 'unix:///var/run/docker.sock'
  }
  stages {
    stage('Checkout') {
      steps {
        checkout([$class: 'GitSCM', 
          branches: [[name: '*/main']], 
          userRemoteConfigs: [[url: 'https://github.com/Omsrrn2018/bug-tracker.git']]
        ])
        sh 'ls -la'
        sh 'ls -la bug-tracker-backend'
      }
    }
    stage('Unit Tests Backend') {
      agent {
        docker {
          image 'snakee/golang-junit:1.21'
          reuseNode true
        }
      }
      steps {
        dir('bug-tracker-backend') {
          sh 'ls -la'
          sh 'go test ./...'
        }
      }
    }
  }
}