pipeline {
    agent any

    environment {
        BACKEND_IMAGE = 'your-backend-image:latest'
        FRONTEND_IMAGE = 'node:20-alpine' // as per your frontend Node.js environment
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Backend Unit Tests') {
            steps {
                script {
                    docker.image(BACKEND_IMAGE).inside {
                        sh 'go test -v ./... -coverprofile=coverage.out'
                        sh 'go tool cover -html=coverage.out -o coverage.html'
                    }
                }
            }
            post {
                always {
                    junit '**/test-results.xml' // adjust path if needed
                    publishHTML(target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: '.',
                        reportFiles: 'coverage.html',
                        reportName: 'Backend Code Coverage'
                    ])
                }
            }
        }

        stage('Frontend Unit Tests') {
            steps {
                script {
                    docker.image(FRONTEND_IMAGE).inside {
                        sh 'npm install'
                        sh 'npm test -- --coverage'
                    }
                }
            }
            post {
                always {
                    junit 'test-results.xml' // adjust path if your frontend test results are here
                    publishHTML(target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'coverage/lcov-report',
                        reportFiles: 'index.html',
                        reportName: 'Frontend Code Coverage'
                    ])
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}