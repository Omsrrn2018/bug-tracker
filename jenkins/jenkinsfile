pipeline {
    agent any  // or specify a particular agent

    stages {
        stage('Launch Application') {
            agent {
                docker {
                    image 'docker:27.5.1'
                    reuseNode true
                    args '-v /var/run/docker.sock:/var/run/docker.sock -u 0'
                }
            }
            steps {
    sh 'which docker-compose'
    sh 'docker-compose --version'
    sh 'docker-compose up --build -d'
}
        }
    }

    post {
        always {
            cleanWS()
        }
    }
}