pipeline {
  agent any
  environment {
    DOCKER_HOST = 'unix:///var/run/docker.sock'
  }
  stages {
    stage('Checkout') {
      steps {
        checkout([$class: 'GitSCM', 
          branches: [[name: '*/main']], 
          userRemoteConfigs: [[url: 'https://github.com/Omsrrn2018/bug-tracker.git']]
        ])
        sh 'find . -type d -or -type f'
      }
    }
    stage('Unit Tests Backend') {
      agent {
        docker {
          image 'snakee/golang-junit:1.21'
          reuseNode true
        }
      }
      steps {
        // Adjust this dir() once we know the correct folder name
        dir('') {
          sh 'ls -la'
          sh 'go test ./...'
        }
      }
    }
  }
}