pipeline {
  agent any
  environment {
    DOCKER_HOST = 'unix:///var/run/docker.sock'
  }
  stages {
    stage('Unit Tests Backend') {
      agent {
        docker {
          image 'snakee/golang-junit:1.21'
          reuseNode true
        }
      }
      steps {
        dir('bug-tracker-backend') {
          sh 'go test ./...'
        }
      }
    }
  }
}