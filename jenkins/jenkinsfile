pipeline {
    agent any

    stages {
        stage('Check Docker Host') {
  steps {
    sh 'echo $DOCKER_HOST'
  }
}
      stage('Unit Tests - Backend') {
  environment {
    DOCKER_HOST = 'unix:///var/run/docker.sock'
  }
  agent {
    docker {
      image 'snakee/golang-junit:1.21'
      reuseNode true
    }
  }
  steps {
    dir('bugtracker-backend') {
      sh 'go test -v ./...'
    }
  }
}
    }
}
