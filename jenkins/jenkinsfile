pipeline {
    agent any

    stages {
        stage('Launch Application') {
            agent {
                docker {
                    image 'docker:27.5.0-dind'
                    args '-v /var/run/docker.sock:/var/run/docker.sock -u 0'
                    reuseNode true
                }
            }
            steps {
                dir('../') {  // Change directory to the project root
                    sh 'docker-compose up --build -d'
                }
            }
        }
    }
}
