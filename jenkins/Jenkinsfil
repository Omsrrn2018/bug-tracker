pipeline {
    agent any

    stages {
        stage('Unit tests backend') {
            agent {
                docker {
                    image 'snakee/golang-junit:1.21'
                    reuseNode true
                    // Set Go caches to writable locations
                    args '-e GOCACHE=/tmp/.cache -e GOMODCACHE=/tmp/go-mod-cache'
                }
            }
            steps {
                dir('bugtracker-backend') {
                    sh 'go test -v ./...'
                }
            }
        }
    }
}